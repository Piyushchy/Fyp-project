# --- multimodal additions ---
# Detector asset: regenerate with `python setup_models.py`
vit-emotion-v2-deployment/models/

# Generated evaluation data: rebuild with `python prepare_eval_data.py`
vit-emotion-v2-deployment/eval_data/

# Evaluation outputs and logs
vit-emotion-v2-deployment/*.log
vit-emotion-v2-deployment/results_face_eval.json
vit-emotion-v2-deployment/results_fusion_eval.json

# Training corpus and checkpoints: regenerate with training/prepare_face_data.py
training/data/
training/best-vit-emotion-v3/
training/*.log
training/vit-emotion-v3.onnx
training/vit-emotion-v3.onnx.data
training/results_*.json

# --- large artefacts, deliberately not committed -------------------
#
# ONNX keeps its tensors in a sibling .onnx.data file (~328 MB each).
# GitHub rejects files over 100 MB, so these ship as Release assets and
# `python setup_models.py` fetches them. The small .onnx graph files are
# committed, so only the weight blobs are missing after a clone.
vit-emotion-v2-deployment/*.onnx.data
training/*.onnx
training/*.onnx.data

# Prepared training corpora: ~4 GB of images derived from FER2013,
# AffectNet and RAF-DB. Not redistributed here - AffectNet in particular
# is licence-restricted. training/prepare_face_data.py rebuilds all of
# it from the original sources in about 25 minutes.
training/data/
training/data_v4/
training/data_v6/
training/data_v5/

# Intermediate HuggingFace checkpoints written during training; the
# exported ONNX is what gets deployed.
training/best-*/
training/label_scores.npz

# Evaluation frames, regenerated by prepare_eval_data.py --source unseen
vit-emotion-v2-deployment/eval_data_unseen/

# Logs
training/*.log
*.log

# v3 and v5 are documented in the READMEs as negative results but their
# weights are not shipped, so their graph files would only produce a
# confusing load error. v2 (already tracked), v4 and v6 are available.
vit-emotion-v2-deployment/vit-emotion-v3.onnx
vit-emotion-v2-deployment/vit-emotion-v5.onnx
